{
  "name": "raptor-journey-planner",
  "version": "4.0.0",
  "description": "Implementation of the Round bAsed Public Transit Optimized Router (Raptor) journey planning algorithm.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "test": "npm run lint && npm run typecheck && vitest run",
    "gtest": "vitest run -t",
    "watch-test": "vitest",
    "typecheck": "tsc --noEmit -p ./",
    "build": "rm -rf ./dist/ && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && cp cjs-package.json dist/cjs/package.json && cp esm-package.json dist/esm/package.json",
    "prepublishOnly": "npm run build",
    "lint": "biome lint src/ test/",
    "int": "tsx ./test/integration.ts",
    "perf": "tsx ./test/performance.ts",
    "patterns": "NODE_OPTIONS='--max-old-space-size=6000' tsx ./src/cli/transfer-patterns.ts",
    "test-patterns": "tsx ./test/transfer-patterns.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/raptor.git"
  },
  "keywords": [
    "Journey",
    "planning",
    "algorith",
    "public",
    "transit"
  ],
  "author": "Linus Norton <linusnorton@gmail.com>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/raptor/issues"
  },
  "homepage": "https://github.com/planarnetwork/raptor#readme",
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/mysql": "2.15.27",
    "@types/node": "24.6.1",
    "@types/progress": "2.0.7",
    "mysql2": "^3.22.2",
    "progress": "2.0.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./worker": {
      "types": "./dist/esm/worker/worker.d.ts",
      "import": "./dist/esm/worker/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/esm/worker/worker.js",
    "./dist/cjs/worker/worker.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "mysql2": ">=3"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    }
  }
}
