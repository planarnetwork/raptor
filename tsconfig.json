{
  "compilerOptions": {
    "moduleResolution": "node16",
    "module": "node16",
    "target": "esnext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "lib": ["esnext", "dom"],
    "types": ["node", "progress"]
  },
  "exclude": ["node_modules", "dist/"]
}
